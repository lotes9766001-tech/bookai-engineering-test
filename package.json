{
  "name": "bookai-commerce-erp-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "render:build": "npm install && npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "seed:official-site": "node scripts/seed-bookai-official-site.js",
    "backup:db": "node scripts/backup-db.js",
    "billing:activate": "node scripts/activate-company.js",
    "demo:engineering": "node scripts/prepare-engineering-demo.js",
    "health": "node scripts/health-check.js",
    "migrate:pg": "node scripts/migrate-sqlite-to-postgres.js",
    "db:pg:migrate:plan": "node scripts/postgres-migrate.js plan",
    "db:pg:migrate:status": "node scripts/postgres-migrate.js status",
    "db:pg:migrate": "node scripts/postgres-migrate.js migrate",
    "db:pg:staging:plan": "node scripts/staging-migrate.js plan",
    "db:pg:staging:status": "node scripts/staging-migrate.js status",
    "db:pg:staging:migrate": "node scripts/staging-migrate.js migrate",
    "schema:pg:check": "node scripts/postgres-schema-contract-check.js",
    "smoke": "node scripts/smoke-test.js",
    "smoke:package-a": "node scripts/package-a-smoke-test.js",
    "smoke:package-a2": "node scripts/package-a2-smoke-test.js",
    "smoke:clean": "node scripts/smoke-clean.js",
    "rbac:smoke": "node scripts/rbac-smoke-test.js",
    "smoke:package-b-core": "node scripts/package-b-core-smoke-test.js",
    "smoke:staging-migration-gate": "node scripts/staging-migration-gate-smoke-test.js",
    "smoke:runtime-schema-version": "node scripts/runtime-schema-version-smoke-test.js",
    "smoke:sqlite-isolation": "node scripts/sqlite-test-isolation-check.js",
    "gate:rc": "node scripts/rc-release-gate.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "vite": "^8.0.14"
  }
}
